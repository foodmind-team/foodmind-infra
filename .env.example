# Copy this file to .env before running Docker Compose. These values are for a
# local workstation only; use unique secrets outside local development.

# Public host ports. Set a different value if a port is already in use.
BACKEND_PORT=8080
# 15432 avoids clashing with an existing local PostgreSQL on 5432. The Backend
# always uses the internal Docker address postgres:5432.
POSTGRES_PORT=15432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL 18.4 local database.
POSTGRES_DB=foodmind
POSTGRES_USER=foodmind
POSTGRES_PASSWORD=foodmind-local-password

# Backend authentication and private service-to-service boundaries. All agent
# tokens must match their corresponding backend values.
JWT_SECRET=foodmind-local-jwt-secret-change-me-at-least-32-bytes
INTERNAL_SERVICE_TOKEN=foodmind-local-backend-tools-token
RECOMMENDATION_AGENT_SERVICE_TOKEN=foodmind-local-recommendation-token
INFERENCE_INTERNAL_SERVICE_TOKEN=foodmind-local-inference-token
COOKING_AGENT_SERVICE_TOKEN=foodmind-local-cooking-token
CHAT_AGENT_SERVICE_TOKEN=foodmind-local-chat-token

# MinIO is always started and its bucket is provisioned. Media is disabled by
# default because browsers outside Docker cannot use an internal MinIO hostname
# for presigned upload URLs. Keep it false unless you have configured a
# browser-reachable S3 endpoint.
MINIO_ROOT_USER=foodmind-minio
MINIO_ROOT_PASSWORD=foodmind-minio-password-change-me
MEDIA_ENABLED=false
MEDIA_S3_BUCKET=foodmind-media
MEDIA_S3_REGION=us-east-1

# DeepSeek is optional. With the default false value every Agent starts and
# uses its deterministic, controlled fallback when an LLM enhancement is not
# available. To enable DeepSeek, set FOODMIND_LLM_ENABLED=true and fill the key.
FOODMIND_LLM_ENABLED=false
DEEPSEEK_API_KEY=
CHAT_AGENT_LLM_MODEL=deepseek-v4-pro
CHAT_AGENT_LLM_TEMPERATURE=1.0
CHAT_AGENT_LLM_MAX_OUTPUT_TOKENS=800
CHAT_AGENT_LLM_THINKING_ENABLED=false

# Compose image labels. `dev` is intended for local source builds only.
FOODMIND_IMAGE_TAG=dev
