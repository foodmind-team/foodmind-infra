# Copy to .env.aws on the EC2 host. Never commit the real file.

# Public endpoint. Route 53 must resolve this name to the EC2 Elastic IP before
# Caddy starts, and the EC2 security group must allow inbound TCP 80 and 443.
FOODMIND_DOMAIN=foodmind.example.com
FOODMIND_ACME_EMAIL=ops@example.com

# The Web repository is deliberately not a submodule. This path is resolved
# relative to foodmind-infra/compose.aws-demo.yaml.
FOODMIND_WEB_CONTEXT=../foodmind-web
FOODMIND_IMAGE_TAG=replace-with-release-git-sha
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

# AWS deployment region and private RDS endpoint.
AWS_REGION=ap-southeast-1
# CloudWatch logging is opt-in. Deploy cloudformation.observability.yaml and
# confirm the SNS email subscription before changing this to true.
FOODMIND_CLOUDWATCH_LOGS_ENABLED=false
CLOUDWATCH_LOG_GROUP=/foodmind/staging/containers
DB_HOST=replace.cluster-id.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=foodmind
DB_USERNAME=foodmind_app
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_RANDOM_VALUE
DB_SSL_MODE=require
DB_POOL_MAX_SIZE=8
DB_POOL_MIN_IDLE=1

# Authentication and private service boundaries. Use independent random values;
# do not reuse the database password or any local values from .env.example.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=foodmind-aws-demo
JWT_AUDIENCE=foodmind-clients
DELEGATION_JWT_ISSUER=foodmind-backend-aws-demo
INTERNAL_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_24_RANDOM_BYTES
RECOMMENDATION_AGENT_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_24_RANDOM_BYTES
INFERENCE_INTERNAL_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_24_RANDOM_BYTES
COOKING_AGENT_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_24_RANDOM_BYTES
CHAT_AGENT_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_24_RANDOM_BYTES

# S3 media. Enable only with the CloudFormation bucket name. Static AWS keys are
# forbidden; the Backend uses its EC2 instance role.
MEDIA_ENABLED=false
MEDIA_S3_BUCKET=

# OneMap tiles need no credential. Walking routes use a short-lived token fetched
# from the exact Secrets Manager ARN. AWS runtime validation rejects static tokens.
ONEMAP_ROUTES_ENABLED=false
ONEMAP_CREDENTIALS_SECRET_ARN=
ONEMAP_API_TOKEN=

# Optional DeepSeek enhancement. The deterministic paths work when disabled.
FOODMIND_LLM_ENABLED=false
DEEPSEEK_API_KEY=

# JVM memory is additionally bounded by the Compose service memory limit.
BACKEND_JAVA_MAX_RAM_PERCENTAGE=70.0
